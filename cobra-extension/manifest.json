{
  "manifest_version": 3,
  "name": "COBRA Bridge",
  "version": "2.99.0",
  "description": "Motore di automazione browser per COBRA: una sola scheda di lavoro, connessione stabile, nessuna finestra aperta d'autorità.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "webNavigation",
    "notifications",
    "cookies",
    "alarms",
    "storage",
    "debugger"
  ],
  "optional_permissions": [
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/cobra-16.png",
      "48": "icons/cobra-48.png",
      "128": "icons/cobra-128.png"
    }
  },
  "icons": {
    "16": "icons/cobra-16.png",
    "48": "icons/cobra-48.png",
    "128": "icons/cobra-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "version_name": "2.99.0 — diario e cancello (9 agosto)"
}